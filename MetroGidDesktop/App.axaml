<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MetroGidDesktop.App"
             xmlns:local="clr-namespace:MetroGidDesktop.Views"
             xmlns:converters="clr-namespace:MetroGidDesktop.Converters"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <converters:AuthStateToButtonTextConverter x:Key="AuthStateToButtonTextConverter"/>
        <converters:AuthStateToButtonColorConverter x:Key="AuthStateToButtonColorConverter"/>
    </Application.Resources>
</Application>