<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MetroGidDesktop.ViewModels"
        xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        x:Class="MetroGidDesktop.Views.AnnihilationDialog"
        x:DataType="local:AnnihilationViewModel"
        Title="Удаление аккаунта"
        MaxWidth="400" MaxHeight="300"
        MinWidth="400" MinHeight="300"
        WindowState="Normal"
        Topmost="True"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Border Background="#4682B4" Padding="20">
        <Grid RowDefinitions="*,Auto,Auto">
             <!-- Предупреждение-->
            <StackPanel Grid.Row="0" Spacing="12">
                <StackPanel Orientation="Vertical" Spacing="8">
                    <TextBlock Text="Пердупреждение" VerticalAlignment="Center" HorizontalAlignment="Stretch" FontSize="16" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock 
                        Text="Удаляя аккаунт, Вы потеряете все данные связанные с ним. То есть все сохраненные маршруты всех схем будут удалены для этого аккаунта на всегда. Также Вы лишитесь возможности сохранять маршруты, пока не зарегистрируете новый аккаунт. Если Вы имели должность, то вы ее потеряете и вам станут не доступны любые имеющиеся на данный момент привелигии."
                        TextWrapping="Wrap"
                        FontSize="14"
                        HorizontalAlignment="Stretch"
                        MaxWidth="400" />
                </StackPanel>
            </StackPanel>

            <!-- Пароль-->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Пароль:" Width="80" VerticalAlignment="Center" FontWeight="Medium"/>
                <TextBox Text="TEST: {Binding Password}" Width="200" />
            </StackPanel>

            <!-- Кнопки -->
            <Grid Grid.Row="3" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" HorizontalAlignment="Left">
                    <Button 
                        Content="Отмена"
                        Width="80"
                        Background="Gray"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,0,10,0"
                        Click="OnCancelClick"/>
                </Border>

                <Border Grid.Column="3" HorizontalAlignment="Right">
                    <Button
                        Content="Удалить аккаунт"
                        Width="160"
                        Background="#DC143C"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding AnnihilationCommand}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>