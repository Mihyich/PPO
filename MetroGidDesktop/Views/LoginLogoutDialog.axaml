<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MetroGidDesktop.ViewModels"
        xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        x:Class="MetroGidDesktop.Views.LoginLogoutDialog"
        x:DataType="local:LoginLogoutViewModel"
        Title="Вход"
        MaxWidth="400" MaxHeight="300"
        MinWidth="400" MinHeight="300"
        WindowState="Normal"
        Topmost="True"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Border Background="#4682B4" Padding="20">
        <Grid RowDefinitions="*,Auto">
            <StackPanel Grid.Row="0" Spacing="12">
                <!-- Логин -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Логин:" Width="80" VerticalAlignment="Center" FontWeight="Medium"/>
                    <TextBox Text="{Binding Login}" Width="200" />
                </StackPanel>

                <!-- Пароль-->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Пароль:" Width="80" VerticalAlignment="Center" FontWeight="Medium"/>
                    <TextBox Text="{Binding Password}" Width="200" />
                </StackPanel>
            </StackPanel>

            <!-- Кнопки -->
            <Grid Grid.Row="3" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" HorizontalAlignment="Left">
                    <Button 
                        Content="Отмена"
                        Width="80"
                        Background="Gray"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,0,10,0"
                        Click="OnCancelClick"/>
                </Border>

                <Border Grid.Column="3" HorizontalAlignment="Right">
                    <Button
                        Content="Войти"
                        Width="80"
                        Background="#32CD32"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Command="{Binding LoginLogoutCommand}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>